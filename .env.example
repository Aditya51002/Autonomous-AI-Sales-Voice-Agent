# Copy to .env and fill in. Never commit .env.

# LiveKit. Cloud: use the URL and keys from your project settings.
# Local server (`livekit-server --dev`): ws://127.0.0.1:7880, devkey, secret
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# https://dashboard.sarvam.ai
SARVAM_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# What the agent sells (placeholder until the real product is chosen)
COMPANY_NAME=Acme Cloud
AGENT_NAME=Asha
PRODUCT_DESCRIPTION=a cloud-based billing and invoicing platform for small businesses

# Optional tuning (defaults shown)
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=300
STT_MODEL=saaras:v4
STT_MODE=codemix
TTS_MODEL=bulbul:v4-flash
TTS_SPEAKER=simran_enhi_customer
ENDPOINTING_MIN_DELAY=0.07
INTERRUPTION_MIN_DURATION=0.5
MAX_CALL_SECONDS=600

# Web origin allowed to call the API
WEB_ORIGIN=http://localhost:3000
# Where the agent finds the API for document search
API_URL=http://127.0.0.1:8000

# Document search
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RETRIEVAL_MIN_SCORE=0.78
RETRIEVAL_TIMEOUT=0.8

# Lead analysis and memory
ANALYSIS_MODEL=gemini-3.5-flash-lite
MIN_MONTHLY_BUDGET_INR=499
MEMORY_WINDOW=12
